# SYS-02 Data Pipeline & Orchestration System Environment Variables

# Airflow Core Settings
AIRFLOW_PROJECT_NAME=sys02_orchestration
AIRFLOW_UID=50000
AIRFLOW_GID=0
AIRFLOW_WEBSERVER_PORT=8085

AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=false

# Airflow Postgres Metadata Database (Isolated Port 5433 on Host)
POSTGRES_USER=replace_with_airflow_db_user
POSTGRES_PASSWORD=replace_with_a_long_unique_password
POSTGRES_DB=replace_with_airflow_metadata_db_name
POSTGRES_HOST=airflow_postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433

# External System Connections (Linked to SYS-05 Lakehouse & Database)
MINIO_ENDPOINT=host.docker.internal:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_a_long_minio_secret
CLICKHOUSE_HOST=host.docker.internal
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=replace_with_clickhouse_user
CLICKHOUSE_PASSWORD=replace_with_a_long_clickhouse_password

# Operational Alerts (SYS-06 Dispatcher Integration)
AIRFLOW_FERNET_KEY=replace_with_a_valid_fernet_key
AIRFLOW_ADMIN_USERNAME=replace_with_airflow_admin_username
AIRFLOW_ADMIN_PASSWORD=replace_with_a_long_airflow_admin_password
AIRFLOW_ADMIN_EMAIL=replace_with_admin_email
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLA_ALERT_ENABLED=true

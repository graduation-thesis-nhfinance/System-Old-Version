# SYS-05 Environment Configuration (Environment Configuration)

# MinIO S3 Configuration
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=replace_with_minio_access_key
MINIO_SECRET_KEY=replace_with_a_long_minio_secret
MINIO_SECURE=false

# MinIO Buckets (Medallion Architecture)
BUCKET_BRONZE=crypto-bronze
BUCKET_SILVER=crypto-silver
BUCKET_GOLD=crypto-gold

# ClickHouse OLAP Configuration
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=replace_with_clickhouse_user
CLICKHOUSE_PASSWORD=replace_with_a_long_clickhouse_password
CLICKHOUSE_DATABASE=default

# PostgreSQL Metadata Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=replace_with_postgres_user
POSTGRES_PASSWORD=replace_with_a_long_postgres_password
POSTGRES_DB=replace_with_postgres_database_name

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9004
POSTGRES_HOST_PORT=5432

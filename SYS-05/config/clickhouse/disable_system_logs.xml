<clickhouse>
    <!-- ========================================================================= -->
    <!-- Disable heavy ClickHouse internal debug & telemetry log tables           -->
    <!-- To prevent generating tens of thousands of small files on Windows NTFS    -->
    <!-- Note: This ONLY affects internal engine metrics; user data is UNTOUCHED. -->
    <!-- ========================================================================= -->
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <trace_log remove="1"/>
    <processors_profile_log remove="1"/>
    <text_log remove="1"/>
    <query_thread_log remove="1"/>
    <query_views_log remove="1"/>
    <part_log remove="1"/>
    <asynchronous_insert_log remove="1"/>
</clickhouse>
